---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import HeroIcon from '@/components/HeroIcon.astro';
import { client } from '@/sanity/client';
import { ALL_PERFILES_QUERY } from '@/sanity/queries';
import type { Perfil } from '@/sanity/types';

const perfiles = await client.fetch<Perfil[]>(ALL_PERFILES_QUERY);

const PREVIEW_COUNT = 3;

const BEAKER_ICON =
  'M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5m4.75-11.396c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 0 1 .244 1.028l-.001.002a2.25 2.25 0 0 1-2.244 2.22H6.2a2.25 2.25 0 0 1-2.244-2.22l-.001-.002A2.25 2.25 0 0 1 4.2 15m15.6 0-3.675-1.845a2.25 2.25 0 0 0-2.25 0L9.75 15M8.25 2.25h7.5';

const FILTROS = [
  { value: 'todos',         label: 'Todos' },
  { value: 'cardiovascular',label: 'Cardiovascular' },
  { value: 'metabolico',    label: 'Metabólico' },
  { value: 'infeccioso',    label: 'Infeccioso' },
  { value: 'femenino',      label: 'Femenino' },
  { value: 'masculino',     label: 'Masculino' },
  { value: 'general',       label: 'General' },
];
---

<BaseLayout
  title="Paquetes y Perfiles de Exámenes"
  description="Baterías de exámenes para etapas de vida, control médico y seguimiento. CIC Laboratorios."
>
  <div class="container-page">

    <Breadcrumb items={[
      { label: 'Inicio', href: '/' },
      { label: 'Exámenes', href: '/examenes' },
      { label: 'Paquetes y perfiles' },
    ]} />

    <header class="mt-6">
      <h1>Paquetes y perfiles</h1>
      <p class="mt-2 text-gray-600 max-w-2xl">
        Conjuntos de exámenes diseñados para cada etapa de vida, controles médicos y detección temprana. Puedes realizar los exámenes que necesites, sin tomar obligatoriamente la totalidad del perfil.
      </p>
    </header>

    <!-- Filter pills -->
    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
      {FILTROS.map((f) => (
        <button
          type="button"
          data-filter={f.value}
          class:list={[
            'filter-pill rounded-full border px-4 py-1.5 text-sm font-medium transition-colors duration-150',
            f.value === 'todos'
              ? 'border-red-600 bg-red-600 text-white'
              : 'border-gray-300 bg-white text-gray-600 hover:border-red-300 hover:bg-red-50 hover:text-red-700',
          ]}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Cards -->
    <ul id="perfiles-grid" role="list" class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {perfiles.map((perfil) => (
        <li
          class="relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white transition-shadow duration-200 hover:shadow-md"
          data-categoria={perfil.categoria}
        >
          {perfil.imagenPortadaUrl ? (
            <img
              src={`${perfil.imagenPortadaUrl}?w=600&h=450&fit=crop&auto=format&q=75`}
              alt=""
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full items-center justify-center bg-gradient-to-br from-navy-800 to-navy-600" aria-hidden="true">
              <div class="rounded-full bg-white/10 p-6">
                <HeroIcon path={BEAKER_ICON} class="h-10 w-10 text-white/70" strokeWidth={1} />
              </div>
            </div>
          )}
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-start gap-3">
              <h2 class="min-w-0 text-4xl leading-snug">
                {perfil.nombre}
              </h2>
            </div>
            <p class="mt-1.5 text-xs text-gray-500 leading-relaxed line-clamp-2">
              {perfil.descripcion}
            </p>

            <!-- Exam preview (first 3) -->
            <ul class="mt-3 space-y-1">
              {perfil.examenesIncluidos.slice(0, PREVIEW_COUNT).map((examen) => (
                <li class="flex items-center gap-1.5 text-xs text-gray-600">
                  <span class="text-green-500 font-bold shrink-0">✓</span>
                  <span class="truncate">{examen.nombre}</span>
                </li>
              ))}
              {perfil.examenesIncluidos.length > PREVIEW_COUNT && (
                <li class="text-xs text-gray-400 pl-4">
                  +{perfil.examenesIncluidos.length - PREVIEW_COUNT} más
                </li>
              )}
            </ul>
          </div>

          <!-- Footer -->
          <div class="flex items-center justify-between border-t border-gray-100 px-5 py-3">
            <span class="text-xs text-gray-400">
              {perfil.examenesIncluidos.length} exámenes
            </span>
            <a
              href={`/examenes/perfiles/${perfil.slug}`}
              class="text-xs font-semibold text-red-600 hover:text-red-700 transition-colors after:absolute after:inset-0"
            >
              Ver perfil →
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- Empty state -->
    <p id="perfiles-empty" class="hidden mt-12 text-center text-sm text-gray-400">
      No hay perfiles en esta categoría.
    </p>

  </div>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLLIElement>('#perfiles-grid > li');
  const empty = document.getElementById('perfiles-empty');

  function applyFilter(filter: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = filter === 'todos' || card.dataset.categoria === filter;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle('border-red-600', active);
        p.classList.toggle('bg-red-600', active);
        p.classList.toggle('text-white', active);
        p.classList.toggle('border-gray-300', !active);
        p.classList.toggle('bg-white', !active);
        p.classList.toggle('text-gray-600', !active);
      });
      applyFilter(pill.dataset.filter ?? 'todos');
    });
  });
</script>
